;;-*-Lisp-*-
(in-package goal)
(require "pc/util/pc-anim-util.gc")
(require "engine/gfx/mood/time-of-day.gc")
(require "engine/level/level.gc")
(require "pc/pckernel-common.gc")

#|
  This file runs the game-specific version of the pckernel.
	See pckernel-common.gc for the bulk of the pckernel.
|#

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;; methods
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;; Sandover settings file (sandover.gc)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun sandover-skip-value ((file file-stream))
  "Skip an unknown key's value, stopping before the ) that closes the key."
  (let ((depth 0)
        (in-string? #f))
    (while #t
      (let ((c (file-stream-getc file)))
        (cond
          ((= c 255) (return 0))
          (in-string? (if (= c #x22) (set! in-string? #f)))
          ((= c #x22) (set! in-string? #t))
          ((= c #x28) (+! depth 1))
          ((= c #x29)
           (when (zero? depth)
             (file-stream-seek file -1 SCE_SEEK_CUR)
             (return 0))
           (+! depth -1))))))
  0)

(defmacro sandover-read-bool (file)
  `(!= (file-stream-read-symbol ,file) #f))

(defun sandover-read-name ((file file-stream))
  "A list value as a symbol. Builds before this one wrote them quoted, so quotes are dropped."
  (file-stream-seek-past-whitespace file)
  (file-stream-read-word file)
  (let* ((s *pc-temp-string*)
         (n (length s)))
    (when (and (>= n 2) (= (-> s data 0) #x22) (= (-> s data (+ n -1)) #x22))
      (dotimes (i (+ n -2))
        (set! (-> s data i) (-> s data (+ i 1))))
      (set! (-> s data (+ n -2)) 0)))
  (string->symbol *pc-temp-string*))

(defun sandover-read-quoted ((file file-stream) (dst (pointer uint8)) (size int))
  "A quoted value into dst, NUL-terminated and cut at size - 1 bytes. A bare word reads as empty."
  (file-stream-seek-past-whitespace file)
  (set! (-> dst 0) 0)
  (let ((c (file-stream-getc file)))
    (cond
      ((= c #x22)
       (let ((n 0)
             (done? #f))
         (until done?
           (set! c (file-stream-getc file))
           (cond
             ((or (= c #x22) (= c 255)) (set! done? #t))
             ((< n (+ size -1)) (set! (-> dst n) c) (+! n 1))))
         (set! (-> dst n) 0)))
      (else
       (file-stream-seek file -1 SCE_SEEK_CUR)
       (file-stream-read-word file))))
  0)

;; the device name as a string, for the writer and the push (sandover-audio-update)
(define *sandover-audio-device-str* (new 'global 'string 128 (the-as string #f)))

;; the version of the sandover.gc being read (sandover-settings-read)
(define *sandover-settings-file-version* SANDOVER_SETTINGS_VERSION)

(defun sandover-field-read ((obj sandover-settings) (f sandover-field) (file file-stream))
  "Read the value of a known key into its field. A value that matches none of its names keeps the field."
  (let ((addr (sandover-field-addr obj f)))
    (case (-> f kind)
      ((SANDOVER_FIELD_BOOL) (set! (-> (the-as (pointer symbol) addr)) (sandover-read-bool file)))
      ((SANDOVER_FIELD_ENUM)
       (let ((name (sandover-read-name file)))
         (dotimes (i (-> f names length))
           (when (= name (-> f names i))
             ;; before version 4 the tiers were SAO deep-low, deep-medium, deep: deep is medium now
             (set! (-> (the-as (pointer int32) addr))
                   (if (and (< *sandover-settings-file-version* 4) (string= (-> f key) "ssao-quality") (or (= i 1) (= i 2)))
                     (+ i -1)
                     i))))))
      ((SANDOVER_FIELD_INTMAP)
       (let ((v (file-stream-read-int file)))
         (dotimes (i (-> f ints length))
           (if (= v (-> f ints i)) (set! (-> (the-as (pointer int32) addr)) i)))))
      ;; read as floats: string->int drops the sign of a decimal
      ((SANDOVER_FIELD_FLOAT)
       (let ((v (file-stream-read-float file)))
         (set! (-> (the-as (pointer float) addr))
               (if (and (logtest? (-> f flags) SANDOVER_FLAG_NEGATIVE) (< v 0.0))
                 -1.0
                 (fmax (-> f lo) (fmin (-> f hi) v))))))
      ((SANDOVER_FIELD_WORD)
       (file-stream-seek-past-whitespace file)
       (file-stream-read-word file)
       (dotimes (i (-> f words length))
         (if (string= *pc-temp-string* (-> f words i)) (set! (-> (the-as (pointer int32) addr)) i))))
      ((SANDOVER_FIELD_BYTES) (sandover-read-quoted file (the-as (pointer uint8) addr) (-> f size)))
      (else (set! (-> (the-as (pointer int32) addr)) (file-stream-read-int file)))))
  0)

(defun sandover-settings-read-key ((obj sandover-settings) (file file-stream))
  "Read the value of the key in *pc-temp-string*; unknown keys are skipped."
  (let ((i (sandover-field-find *pc-temp-string*)))
    (if (< i 0)
      (sandover-skip-value file)
      (sandover-field-read obj (-> *sandover-fields* i) file)))
  0)

(defun sandover-settings-read ((obj sandover-settings) (filename string))
  "Read a sandover.gc file into obj. Missing keys keep their value; unknown keys are skipped,
   so an older build reads a newer file. Returns #f if the file is missing or malformed."
  (let ((file (new 'stack 'file-stream filename 'read)))
    (when (not (file-stream-valid? file))
      (return #f))
    (with-settings-scope (file)
                         (case-str (file-stream-read-word file)
                           (("sandover")
                            (let ((version (file-stream-read-int file)))
                              (if (> version SANDOVER_SETTINGS_VERSION)
                                (format 0 "[PC] sandover.gc version ~D is newer than ~D, reading known keys~%" version SANDOVER_SETTINGS_VERSION))
                              (set! *sandover-settings-file-version* version)
                              (dosettings (file) (sandover-settings-read-key obj file))
                              ;; version 1 saved scRGB as the untouched default; HDR10 is the default since 2
                              (if (and (< version 2) (zero? (-> obj hdr-output)))
                                (set! (-> obj hdr-output) 1))
                              ;; before 3 the sun rode on neighbours; the material look and tonemap rows
                              ;; are gone, so the picked looks apply
                              (when (< version 3)
                                (set! (-> obj sun?) (-> obj vista?))
                                (set! (-> obj pbr-look) 1)
                                (set! (-> obj tonemap) 2))))
                           (else (pc-settings-read-throw-error file "not a sandover settings file"))))
    (file-stream-close file))
  #t)

(defun sandover-field-write ((obj sandover-settings) (f sandover-field) (file file-stream) (msaa int))
  "Write a field as its key's line. The int row writes the msaa argument, and only when it is not negative."
  (when (or (!= (-> f kind) SANDOVER_FIELD_INT) (>= msaa 0))
    (let* ((addr (sandover-field-addr obj f))
           (v (-> (the-as (pointer int32) addr))))
      (format file "  (~S " (-> f key))
      (case (-> f kind)
        ((SANDOVER_FIELD_BOOL) (format file "~A" (-> (the-as (pointer symbol) addr))))
        ((SANDOVER_FIELD_ENUM)
         (format file "~A" (-> f names (if (and (>= v 0) (< v (-> f names length))) v (-> f fallback)))))
        ((SANDOVER_FIELD_INTMAP)
         (format file "~D" (-> f ints (if (and (>= v 0) (< v (-> f ints length))) v (-> f fallback)))))
        ((SANDOVER_FIELD_FLOAT)
         (let* ((x (-> (the-as (pointer float) addr)))
                (w (if (and (logtest? (-> f flags) SANDOVER_FLAG_NEGATIVE) (< x 0.0)) -1.0 x)))
           (if (logtest? (-> f flags) SANDOVER_FLAG_DECIMALS)
             (format file "~,,3f" w)
             (format file "~D" (the int w)))))
        ((SANDOVER_FIELD_WORD)
         (format file "~S" (-> f words (if (and (>= v 0) (< v (-> f words length))) v (-> f fallback)))))
        ;; ~A prints a string in quotes
        ((SANDOVER_FIELD_BYTES)
         (format file "~A" (string<-charp *sandover-audio-device-str* (the-as (pointer uint8) addr))))
        (else (format file "~D" msaa)))
      (format file ")~%")))
  0)

(defun sandover-settings-write ((obj sandover-settings) (filename string) (msaa int))
  "Write obj as a sandover.gc file; msaa >= 0 adds the MSAA key (the VR profile's file)."
  (let ((file (new 'stack 'file-stream filename 'write)))
    (if (not (file-stream-valid? file)) (return #f))
    (format file "(sandover ~D~%" SANDOVER_SETTINGS_VERSION)
    (dotimes (i (-> *sandover-fields* length))
      (sandover-field-write obj (-> *sandover-fields* i) file msaa))
    (format file "  )~%")
    (file-stream-close file))
  (format 0 "[PC] Sandover settings write: ~A~%" filename)
  #t)

(define *sandover-settings-loaded?* #f)

(defun sandover-first-boot! ((obj pc-settings-jak1))
  "No sandover.gc yet: the Sandover defaults, and Sandover's MSAA over one a stock build saved."
  (set! (-> obj gfx-msaa) PC_DEFAULT_MSAA)
  (sandover-settings-reset! (-> obj sandover))
  0)

(defun sandover-profile-file ((profile symbol))
  "The file of a profile, in *pc-temp-string-1*: sandover.gc (flat screen) or sandover-vr.gc."
  (format (clear *pc-temp-string-1*) (if (= profile 'vr) "~S/sandover-vr.gc" "~S/sandover.gc") *pc-settings-folder*))

(defun sandover-profile-settings ((profile symbol))
  "The settings of a profile: the active ones (*pc-settings* sandover) or the stored other ones."
  (if (= profile *sandover-profile*) (-> *pc-settings* sandover) (-> *pc-settings* sandover-other)))

(defun sandover-profile-msaa ((profile symbol))
  "A profile's MSAA: the stock row's value (gfx-msaa) for the active profile, else its stored value."
  (if (= profile *sandover-profile*) (-> *pc-settings* gfx-msaa) (-> *pc-settings* sandover-other msaa)))

(defun sandover-settings-load ((obj pc-settings-jak1))
  "Read sandover.gc (flat screen, the active profile at boot) and sandover-vr.gc from the settings
   folder. A missing file is written with its profile's defaults."
  (set! *sandover-profile* 'flat)
  (sandover-profile-file 'flat)
  (cond
    ((pc-filepath-exists? *pc-temp-string-1*)
     (cond
       ((sandover-settings-read (-> obj sandover) *pc-temp-string-1*)
        (format 0 "[PC] Sandover settings read: ~S~%" *pc-temp-string-1*))
       (else
        (format 0 "[PC] Sandover settings at ~S could not be read, using defaults~%" *pc-temp-string-1*)
        (sandover-settings-reset! (-> obj sandover)))))
    (else
     (sandover-first-boot! obj)
     ((method-of-type pc-settings commit-to-file) obj)
     (sandover-profile-file 'flat)
     (pc-mkdir-file-path *pc-temp-string-1*)
     (sandover-settings-write (-> obj sandover) *pc-temp-string-1* -1)))
  ;; the VR profile; an MSAA it does not name starts from the flat screen's
  (sandover-settings-reset-vr! (-> obj sandover-other))
  (set! (-> obj sandover-other msaa) -1)
  (sandover-profile-file 'vr)
  (cond
    ((pc-filepath-exists? *pc-temp-string-1*)
     (cond
       ((sandover-settings-read (-> obj sandover-other) *pc-temp-string-1*)
        (format 0 "[PC] Sandover VR settings read: ~S~%" *pc-temp-string-1*))
       (else
        (format 0 "[PC] Sandover VR settings at ~S could not be read, using defaults~%" *pc-temp-string-1*)
        (sandover-settings-reset-vr! (-> obj sandover-other))
        (set! (-> obj sandover-other msaa) -1))))
    (else
     (if (< (-> obj sandover-other msaa) 0) (set! (-> obj sandover-other msaa) (-> obj gfx-msaa)))
     (pc-mkdir-file-path *pc-temp-string-1*)
     (sandover-settings-write (-> obj sandover-other) *pc-temp-string-1* (-> obj sandover-other msaa))))
  (if (< (-> obj sandover-other msaa) 0) (set! (-> obj sandover-other msaa) (-> obj gfx-msaa)))
  (set! *sandover-settings-loaded?* #t)
  0)

(defun sandover-profile-switch! ((profile symbol))
  "Make profile the active one: swap the two settings sets and the stock MSAA value. The next
   sandover-settings-update pushes whatever differs."
  (when (!= profile *sandover-profile*)
    (let ((tmp (new 'stack-no-clear 'sandover-settings))
          (a (-> *pc-settings* sandover))
          (b (-> *pc-settings* sandover-other)))
      (set! (-> a msaa) (-> *pc-settings* gfx-msaa))
      (mem-copy! (the-as pointer tmp) (the-as pointer a) (size-of sandover-settings))
      (mem-copy! (the-as pointer a) (the-as pointer b) (size-of sandover-settings))
      (mem-copy! (the-as pointer b) (the-as pointer tmp) (size-of sandover-settings))
      (set! (-> *pc-settings* gfx-msaa) (-> a msaa)))
    (set! *sandover-profile* profile)
    ;; a profile saved with vanilla rendering pushes nothing at the switch: say so
    (format 0 "[PC] Sandover settings profile: ~A~S~%" profile
            (if (-> *pc-settings* sandover vanilla?) " (vanilla rendering)" "")))
  profile)

(defmethod commit-to-file ((obj pc-settings-jak1))
  "commits the current settings to the file, then the Sandover settings to sandover.gc and
   sandover-vr.gc. pc-settings.gc always gets the flat screen's MSAA."
  (let ((msaa (-> obj gfx-msaa)))
    (set! (-> obj gfx-msaa) (sandover-profile-msaa 'flat))
    ((method-of-type pc-settings commit-to-file) obj)
    (set! (-> obj gfx-msaa) msaa))
  ;; not before the load: a first boot commits pc-settings.gc before sandover.gc is read
  (when *sandover-settings-loaded?*
    (sandover-profile-file 'flat)
    (sandover-settings-write (sandover-profile-settings 'flat) *pc-temp-string-1* -1)
    (sandover-profile-file 'vr)
    (sandover-settings-write (sandover-profile-settings 'vr) *pc-temp-string-1* (sandover-profile-msaa 'vr)))
  (none))

(defmethod initialize ((obj pc-settings-jak1))
  "initial initialize method to be run after allocating"
  ((method-of-type pc-settings initialize) obj)
  (sandover-settings-load obj)
  (set! (-> *setting-control* default sfx-volume) (-> obj memcard-volume-sfx))
  (set! (-> *setting-control* default music-volume) (-> obj memcard-volume-music))
  (set! (-> *setting-control* default dialog-volume) (-> obj memcard-volume-dialog))
  (set! (-> *setting-control* default vibration) (-> obj memcard-vibration?))
  (set! (-> *setting-control* default play-hints) (-> obj memcard-play-hints?))
  obj)

(defmethod set-game-setting! ((obj pc-settings-jak1) (setting symbol) (value symbol))
  (case setting
    (('video-mode)
     (set! (-> *setting-control* current video-mode) #f)
     (set! (-> *setting-control* default video-mode) value))
    (('aspect-ratio) (set! (-> *setting-control* default aspect-ratio) value))
    (else (format #t "unknown setting  ~A (~A) to set-game-setting!" setting value))))

(defmethod get-game-setting ((obj pc-settings-jak1) (setting symbol))
  (case setting
    (('video-mode) (-> *setting-control* default video-mode))
    (('aspect-ratio) (-> *setting-control* default aspect-ratio))
    (else (format #t "unknown setting  ~A to get-game-setting" setting) #f)))

(defmethod set-game-language! ((obj pc-settings-jak1) (lang language-enum))
  (set! (-> *setting-control* default language) lang))

(defmethod get-game-language ((obj pc-settings-jak1))
  (-> *setting-control* default language))

;; where we store the input progress for the cheat codes. make sure there's enough space for all cheats.
(define *pc-cheat-temp* (new 'global 'inline-array 'uint8 PC_CHEAT_MAX))

(defmethod update-cheats ((obj pc-settings-jak1))
  "run cheats."
  ;; first check for cheat inputs.
  (when (and (cpad-hold? 0 l2) (cpad-hold? 0 l1) (cpad-hold? 0 r2) (cpad-hold? 0 r1))
    (pc-check-cheat-code (-> *pc-cheat-temp* 0)
                         0
                         spirit
                         :extra (x)
                         (logclear! (-> obj cheats) (pc-cheats eco-red eco-yellow eco-green))
                         (pc-cheat-toggle-and-tune (-> obj cheats) eco-blue))
    (pc-check-cheat-code (-> *pc-cheat-temp* 1)
                         0
                         spirit
                         :extra (circle)
                         (logclear! (-> obj cheats) (pc-cheats eco-blue eco-yellow eco-green))
                         (pc-cheat-toggle-and-tune (-> obj cheats) eco-red))
    (pc-check-cheat-code (-> *pc-cheat-temp* 2)
                         0
                         spirit
                         :extra (triangle)
                         (logclear! (-> obj cheats) (pc-cheats eco-red eco-yellow eco-blue))
                         (pc-cheat-toggle-and-tune (-> obj cheats) eco-green))
    (pc-check-cheat-code (-> *pc-cheat-temp* 3)
                         0
                         spirit
                         :extra (square)
                         (logclear! (-> obj cheats) (pc-cheats eco-red eco-blue eco-green))
                         (pc-cheat-toggle-and-tune (-> obj cheats) eco-yellow))
    (pc-check-cheat-code (-> *pc-cheat-temp* 4)
                         0
                         undead
                         (logclear! (-> *target* state-flags) 16)
                         (pc-cheat-toggle-and-tune (-> obj cheats) invinc))
    (pc-check-cheat-code (-> *pc-cheat-temp* 5) 0 bluemoon (pc-cheat-toggle-and-tune (-> obj cheats) sidekick-blue))
    (pc-check-cheat-code (-> *pc-cheat-temp* 6) 0 boombox (pc-cheat-toggle-and-tune (-> obj cheats) tunes))
    (pc-check-cheat-code (-> *pc-cheat-temp* 7) 0 skies (pc-cheat-toggle-and-tune (-> obj cheats) sky))
    (pc-check-cheat-code (-> *pc-cheat-temp* 8) 0 speclum (pc-cheat-toggle-and-tune (-> obj cheats) mirror))
    (pc-check-cheat-code (-> *pc-cheat-temp* 9) 0 brains (pc-cheat-toggle-and-tune (-> obj cheats) big-head))
    (pc-check-cheat-code (-> *pc-cheat-temp* 10) 0 driedup (pc-cheat-toggle-and-tune (-> obj cheats) small-head))
    (pc-check-cheat-code (-> *pc-cheat-temp* 11) 0 yourpalm (pc-cheat-toggle-and-tune (-> obj cheats) big-fist))
    (pc-check-cheat-code (-> *pc-cheat-temp* 12) 0 bakeonly (pc-cheat-toggle-and-tune (-> obj cheats) no-tex))
    ;(pc-check-cheat-code (-> *pc-cheat-temp* 13) 0 rodent (pc-cheat-toggle-and-tune (-> obj cheats) hard-rats))
    ;(pc-check-cheat-code (-> *pc-cheat-temp* 14) 0 lunatic (pc-cheat-toggle-and-tune (-> obj cheats) hero-mode))
    (pc-check-cheat-code (-> *pc-cheat-temp* 15) 0 plzstop (pc-cheat-toggle-and-tune (-> obj cheats) huge-head))
    (pc-check-cheat-code (-> *pc-cheat-temp* 16) 0 evilbabe (pc-cheat-toggle-and-tune (-> obj cheats) oh-my-goodness))
    (pc-check-cheat-code (-> *pc-cheat-temp* 17) 0 smart (pc-cheat-toggle-and-tune (-> obj cheats) big-head-npc)))
  ;; run cheats here.
  ;;;;;;;;;;;;;;;;;;;
  (when *target*
    ;; hook custom animation callback
    (if (nonzero? (-> *target* skel)) (set! (-> *target* skel postbind-function) target-joint-callback-pc))
    (with-pp
      (protect ((-> *target* fact eco-source)
            *sound-player-enable*)
        ;; act as if this isnt a new source of eco to prevent spamming sounds. then restore the old source!
        (when (< 0 (-> *target* fact eco-level))
          (set! (-> *target* fact eco-source) (process->handle pp))
          (false! *sound-player-enable*))
        (cond
          ;; green eco!
          ((pc-cheats? (-> obj cheats) eco-green)
           (when (or (= (-> *target* fact eco-type) (pickup-type eco-green)) (<= (-> *target* fact eco-level) 0.0))
             (define-extern vent type)
             (protect ((-> pp type)
                   (-> *target* control root-prim prim-core action))
               (set! (-> pp type) vent)
               (logior! (-> *target* control root-prim prim-core action) (collide-action racer))
               (send-event *target* 'get-pickup (pickup-type eco-green) (-> *FACT-bank* eco-full-inc)))))
          ;; red eco!
          ((pc-cheats? (-> obj cheats) eco-red)
           (when (or (= (-> *target* fact eco-type) (pickup-type eco-red)) (<= (-> *target* fact eco-level) 0.0))
             (send-event *target* 'get-pickup (pickup-type eco-red) (-> *FACT-bank* eco-full-inc))))
          ;; blue eco!
          ((pc-cheats? (-> obj cheats) eco-blue)
           (when (or (= (-> *target* fact eco-type) (pickup-type eco-blue)) (<= (-> *target* fact eco-level) 0.0))
             (protect ((-> *target* event-hook))
               (set! (-> *target* event-hook) target-generic-event-handler)
               (send-event *target* 'get-pickup (pickup-type eco-blue) (-> *FACT-bank* eco-full-inc)))
             (send-event *target* 'boost (-> *FACT-bank* eco-single-inc))))
          ;; yellow eco!
          ((pc-cheats? (-> obj cheats) eco-yellow)
           (when (or (= (-> *target* fact eco-type) (pickup-type eco-yellow)) (<= (-> *target* fact eco-level) 0.0))
             (send-event *target* 'get-pickup (pickup-type eco-yellow) (-> *FACT-bank* eco-full-inc)))))))
    (when (pc-cheats? (-> obj cheats) invinc)
      (logior! (-> *target* state-flags) (state-flags invulnerable))))
  (if (pc-cheats? (-> obj cheats) tunes) (set! (-> obj flava-hack) -1) (set! (-> obj flava-hack) 0))
  (if (pc-cheats? (-> obj cheats) sky)
    (let ((date (new 'stack-no-clear 'scf-time)))
      (scf-get-time date)
      (when (zero? (-> date stat))
        (set-time-of-day (+ (the float (bcd->dec (-> date hour))) (/ (the float (bcd->dec (-> date minute))) 60))))))
  (pc-set-gfx-hack (pc-gfx-hack no-tex) (logtest? (-> obj cheats) (pc-cheats no-tex)))
  (if (or (pc-cheats? (-> obj cheats) mirror) *PC-MIRROR-MODE-SET*)
    (sound-set-mirror-mode (sound-mirror-mode mirrored))
    (sound-set-mirror-mode (sound-mirror-mode normal)))
  ;; run cheats end!!!
  ;;;;;;;;;;;;;;;;;;;;
  (logior! (-> obj cheats-known) (-> obj cheats))
  0)

(defmethod update-music-log ((obj pc-settings-jak1))
  "update music log settings."
  ;; add whatever is playing to the music log.
  (add-to-music-log obj (-> *setting-control* current music) (the int (-> *setting-control* current sound-flava)))
  ;; special cases. for example, npc's that despawn and you can't hear their music anymore.
  (if (task-closed? (game-task village1-buzzer) (task-status need-resolution))
    (add-to-music-log obj 'village1 (flava-lookup 'village1 (music-flava assistant))))
  (if (task-closed? (game-task village2-buzzer) (task-status need-resolution))
    (add-to-music-log obj 'village2 (flava-lookup 'village2 (music-flava assistant))))
  (if (task-closed? (game-task village3-buzzer) (task-status need-resolution))
    (add-to-music-log obj 'village3 (flava-lookup 'village3 (music-flava assistant))))
  (when (task-closed? (game-task beach-ecorocks) (task-status need-introduction))
    (add-to-music-log obj 'village1 1)
    (add-to-music-log obj 'village1 (flava-lookup 'village1 (music-flava sage))))
  (if (task-closed? (game-task jungle-plant) (task-status need-resolution)) (add-to-music-log obj 'jungleb 2))
  (if (task-closed? (game-task beach-flutflut) (task-status need-resolution))
    (add-to-music-log obj 'beach (flava-lookup 'beach (music-flava birdlady))))
  (if (task-closed? (game-task beach-flutflut) (task-status need-resolution))
    (add-to-music-log obj 'village1 (flava-lookup 'village1 (music-flava birdlady))))
  (if (task-closed? (game-task misty-warehouse) (task-status need-resolution))
    (add-to-music-log obj 'misty (flava-lookup 'misty (music-flava misty-battle))))
  (if (task-closed? (game-task misty-cannon) (task-status need-resolution)) (add-to-music-log obj 'misty 4))
  (if (task-closed? (game-task firecanyon-end) (task-status need-resolution)) (add-to-music-log obj 'firecanyon 2))
  (if (task-closed? (game-task village2-levitator) (task-status need-hint))
    (add-to-music-log obj 'village2 (flava-lookup 'village2 (music-flava sage))))
  (if (task-closed? (game-task swamp-billy) (task-status need-resolution)) (add-to-music-log obj 'swamp 1))
  (if (task-closed? (game-task swamp-battle) (task-status need-resolution))
    (add-to-music-log obj 'swamp (flava-lookup 'swamp (music-flava swamp-battle))))
  (if (task-closed? (game-task village3-button) (task-status need-hint))
    (add-to-music-log obj 'village3 (flava-lookup 'village3 (music-flava sage))))
  (if (task-closed? (game-task snow-bunnies) (task-status need-resolution))
    (add-to-music-log obj 'snow (flava-lookup 'snow (music-flava snow-battle))))
  (if (task-closed? (game-task citadel-sage-yellow) (task-status need-resolution))
    (add-to-music-log obj 'citadel (flava-lookup 'citadel (music-flava sage-yellow))))
  (if (task-closed? (game-task citadel-sage-red) (task-status need-resolution))
    (add-to-music-log obj 'citadel (flava-lookup 'citadel (music-flava sage-red))))
  (if (task-closed? (game-task citadel-sage-blue) (task-status need-resolution))
    (add-to-music-log obj 'citadel (flava-lookup 'citadel (music-flava sage-blue))))
  (if (task-closed? (game-task citadel-sage-green) (task-status need-resolution))
    (add-to-music-log obj 'citadel (flava-lookup 'citadel (music-flava sage))))
  (if (task-closed? (game-task citadel-buzzer) (task-status need-resolution))
    (add-to-music-log obj 'citadel (flava-lookup 'citadel (music-flava assistant))))
  (when (task-closed? (game-task finalboss-movies) (task-status unknown))
    (add-to-music-log obj 'finalboss (flava-lookup 'finalboss (music-flava finalboss-middle)))
    (add-to-music-log obj 'finalboss (flava-lookup 'finalboss (music-flava finalboss-end))))
  (when (and *target* (>= (float->int (send-event *target* 'query 'pickup (pickup-type fuel-cell))) 100))
    (add-to-music-log obj 'credits 0)
    (add-to-music-log obj 'credits 1)
    (add-to-music-log obj 'credits 2))
  0)

(defmethod update-discord-rpc ((obj pc-settings-jak1))
  "update discord rpc module"
  (let ((info (new 'stack 'discord-info)))
    (set! (-> info fuel) (&-> *game-info* fuel))
    (set! (-> info money-total) (&-> *game-info* money-total))
    (set! (-> info buzzer-total) (&-> *game-info* buzzer-total))
    (set! (-> info deaths) (&-> *game-info* total-deaths))
    (set! (-> info status) "Playing Jak and Daxter: The Precursor Legacy™")
    (set! (-> info level) (symbol->string (-> (level-get-target-inside *level*) name))) ;; grab the name of level we're in
    (set! (-> info cutscene?) (real-movie?))
    (set! (-> info ogreboss?)
          (aif (process-by-ename "ogreboss-1")
               (case (-> it next-state name)
                 (('ogreboss-die 'ogreboss-idle
                                'ogreboss-stage1
                                'ogreboss-stage2
                                'ogreboss-stage3-hit
                                'ogreboss-stage3-shuffle
                                'ogreboss-stage3-throw
                                'ogreboss-wait-for-player)
                  #t))))
    (set! (-> info plant-boss?)
          (aif (process-by-ename "plant-boss-3")
               (case (-> it next-state name)
                 (('plant-boss-idle 'plant-boss-hit 'plant-boss-vulnerable 'plant-boss-spawn 'plant-boss-reset 'plant-boss-attack) #t))))
    (set! (-> info racer?)
          (aif *target*
               (case (-> it next-state name)
                 (('target-racing 'target-racing-bounce
                                 'target-racing-death
                                 'target-racing-falling
                                 'target-racing-grab
                                 'target-racing-hit
                                 'target-racing-jump
                                 'target-racing-smack
                                 'target-racing-start)
                  #t))))
    (set! (-> info flutflut?)
          (aif *target*
               (case (-> it next-state name)
                 (('target-flut-air-attack 'target-flut-air-attack-hit-ground
                                          'target-flut-double-jump
                                          'target-flut-falling
                                          'target-flut-grab
                                          'target-flut-hit
                                          'target-flut-hit-ground
                                          'target-flut-jump
                                          'target-flut-running-attack
                                          'target-flut-stance
                                          'target-flut-start
                                          'target-flut-walk)
                  #t))))
    (set! (-> info time-of-day) (&-> *time-of-day-context* time))
    (with-profiler "discord-update"
      (pc-discord-rpc-update info)))
  (none))

(defmethod update-speedrun ((obj pc-settings-jak1))
  "update speedrun module"
  (with-profiler "speedrun-update"
    (speedrun-mode-update))
  (none))

(defmethod update-video-hacks ((obj pc-settings-jak1))
  "update the graphics hacks used for sprites and other things. ugh."
  (set! (-> (get-video-params) relative-x-scale) (-> obj aspect-ratio-reciprocal))
  (set! (-> (get-video-params) relative-x-scale-reciprical) (-> obj aspect-ratio-scale))
  (set! (-> *font-default-matrix* vector 0 x) (-> (get-video-params) relative-x-scale))
  (set-hud-aspect-ratio 'aspect4x3 'ntsc) ;; set hud aspect ratios every frame because why not?
  (when *progress-process*
    ;; adjust sizes for progress.
    ;; video.gc sets the sizes in the normal game.
    ;; this is a complete hack and i'm losing it
    (let ((pr (-> *progress-process*))
          ;(wide-adjust (* 4.0 (- (/ (-> obj aspect-ratio-scale) ASPECT_16X9_SCALE) (1/ ASPECT_16X9_SCALE))))
          )
      (set! (-> pr sides-x-scale) 1.0)
      (set! (-> pr sides-y-scale) 13.0)
      ;(set! (-> pr left-x-offset) (+ 59 (the int (* (-> obj aspect-ratio-scale) -59))))
      ;(set! (-> pr right-x-offset) 26)
      ;(set! (-> pr button-scale) (+ 1.0 (* wide-adjust 0.1)))
      )))

(defmethod led-enabled? ((obj pc-settings-jak1))
  "should the controller led be set?"
  (or (-> obj controller-led-hp?) (-> obj controller-led-eco?) (-> obj controller-led-heat?)))

(defmethod update-led ((obj pc-settings-jak1))
  "set the controller led color by modifying the controller-led-color vector"
  ;; default color is just blue.
  (set! (-> obj controller-led-color r) 0.0)
  (set! (-> obj controller-led-color g) 0.0)
  (set! (-> obj controller-led-color b) 1.0)
  (when *target*
    (let ((set-no-eco-color? #t))
      (when (-> obj controller-led-hp?)
        ;; flicker led according to hp. lower hp = faster and more intense flicker
        (cond
          ((= (-> *target* fact health) 0.0)
           ;; dead. just set to minimum brightness.
           (set! (-> obj controller-led-color a) (-> obj controller-led-min-brightness)))
          (else
           (let ((flicker-speed (lerp-scale 2.0 0.0 (-> *target* fact health) 1.0 (-> *FACT-bank* health-max-default)))
                 (flicker-amp (lerp-scale (- 1.0 (-> obj controller-led-min-brightness))
                                          (- 1.0 (-> obj controller-led-max-brightness))
                                          (-> *target* fact health)
                                          1.0
                                          (-> *FACT-bank* health-max-default))))
             (set! (-> obj controller-led-color a)
                   (- 1.0 (* flicker-amp (/ (+ 1.0 (sin (* flicker-speed (degrees (-> *display* game-frame-counter))))) 2.0))))))))
      (when (and (-> obj controller-led-heat?)
                 (nonzero? (-> *target* racer))
                 (logtest? (-> *target* control root-prim prim-core action) (collide-action racer))
                 (or (= (-> *target* current-level name) 'lavatube)
                     (= (-> *target* current-level name) 'firecanyon)
                     (= (-> *target* current-level name) 'citadel)))
        (defun-extern zoomer-heat-slice-color matrix float none)
        (defun-extern zoomer-get-heat float)
        (defun-extern zoomer-get-heat-max float)
        (let ((temp-mtx (new-stack-matrix0))
              (heat (/ (zoomer-get-heat) (zoomer-get-heat-max))))
          (zoomer-heat-slice-color temp-mtx heat)
          (when (< 0.0 heat)
            (set! (-> obj controller-led-color r) (/ (-> temp-mtx vector 2 x) 128.0))
            (set! (-> obj controller-led-color g) (/ (-> temp-mtx vector 2 y) 128.0))
            (set! (-> obj controller-led-color b) (/ (-> temp-mtx vector 2 z) 128.0))
            (false! set-no-eco-color?))))
      (when (-> obj controller-led-eco?)
        ;; get remaining eco as a number from 0.0 to 1.0
        (let ((eco-remain-fac (/ (the float (- (-> *target* fact eco-timeout) (- (-> *display* game-frame-counter) (-> *target* fact eco-pickup-time))))
                                 (the float (-> *FACT-bank* eco-full-timeout)))))
          (when set-no-eco-color?
            (set! (-> obj controller-led-color r) 1.0)
            (set! (-> obj controller-led-color g) 1.0)
            (set! (-> obj controller-led-color b) 1.0))
          ;; dont set eco color if we don't have eco.
          (when (< 0.0 eco-remain-fac)
            ;; set color according to eco type. matches the color in the meter!
            (case (-> *target* fact eco-type)
              (((pickup-type eco-blue))
               (set! (-> obj controller-led-color r) 0.0)
               (set! (-> obj controller-led-color g) 0.5)
               (set! (-> obj controller-led-color b) 1.0))
              (((pickup-type eco-yellow))
               (set! (-> obj controller-led-color r) 1.0)
               (set! (-> obj controller-led-color g) 0.75)
               (set! (-> obj controller-led-color b) 0.0))
              (((pickup-type eco-red))
               (set! (-> obj controller-led-color r) 1.0)
               (set! (-> obj controller-led-color g) 0.25)
               (set! (-> obj controller-led-color b) 0.0))
              (((pickup-type eco-green))
               (set! (-> obj controller-led-color r) 0.0)
               (set! (-> obj controller-led-color g) 1.0)
               (set! (-> obj controller-led-color b) 0.25)))
            ;; less than 20% eco remaining, so we flash. same as eco meter.
            (when (and (< eco-remain-fac 0.2) (zero? (logand (the int (* DISPLAY_FPS_RATIO (-> *display* integral-frame-counter))) 4)))
              (*! (-> obj controller-led-color g) 2.0)))))))
  #t)

(defun find-music-log ((music symbol))
  "return #t if the given music is logged into the *pc-settings*, #f otherwise."
  (dotimes (i PC_MUSIC_LOG_LENGTH)
    (if (= music (-> *pc-settings* secrets music i name)) (return #t)))
  #f)

(defun find-flava-log ((music symbol) (flava-idx int))
  "return #t if the given music's flava is logged into the *pc-settings*, #f otherwise."
  (dotimes (i PC_MUSIC_LOG_LENGTH)
    (if (= music (-> *pc-settings* secrets music i name))
      (return (logtest? (-> *pc-settings* secrets music i flava-mask) (ash 1 flava-idx)))))
  #f)

(defun-debug print-music-log ((out object))
  "prints the *pc-settings* music log."
  (dotimes (i PC_MUSIC_LOG_LENGTH)
    (if (-> *pc-settings* secrets music i name)
      (format out
              "music log ~D: ~A (f #x~x)~%"
              i
              (-> *pc-settings* secrets music i name)
              (-> *pc-settings* secrets music i flava-mask))))
  0)

(defun-debug unlock-music-log ()
  "fills the music log with every track and flava"
  (dotimes (i PC_MUSIC_LOG_LENGTH)
    (set! (-> *pc-settings* secrets music i name) #f)
    (set! (-> *pc-settings* secrets music i flava-mask) 0))
  (set! (-> *pc-settings* secrets music 0 name) 'fishgame)
  (set! (-> *pc-settings* secrets music 1 name) 'danger)
  (set! (-> *pc-settings* secrets music 2 name) 'village1)
  (set! (-> *pc-settings* secrets music 3 name) 'beach)
  (set! (-> *pc-settings* secrets music 4 name) 'jungle)
  (set! (-> *pc-settings* secrets music 5 name) 'jungleb)
  (set! (-> *pc-settings* secrets music 6 name) 'misty)
  (set! (-> *pc-settings* secrets music 7 name) 'firecanyon)
  (set! (-> *pc-settings* secrets music 8 name) 'village2)
  (set! (-> *pc-settings* secrets music 9 name) 'swamp)
  (set! (-> *pc-settings* secrets music 10 name) 'sunken)
  (set! (-> *pc-settings* secrets music 11 name) 'rolling)
  (set! (-> *pc-settings* secrets music 12 name) 'ogre)
  (set! (-> *pc-settings* secrets music 13 name) 'ogreboss)
  (set! (-> *pc-settings* secrets music 14 name) 'village3)
  (set! (-> *pc-settings* secrets music 15 name) 'snow)
  (set! (-> *pc-settings* secrets music 16 name) 'maincave)
  (set! (-> *pc-settings* secrets music 17 name) 'lavatube)
  (set! (-> *pc-settings* secrets music 18 name) 'citadel)
  (set! (-> *pc-settings* secrets music 19 name) 'finalboss)
  (set! (-> *pc-settings* secrets music 20 name) 'credits)
  (dotimes (i PC_MUSIC_LOG_LENGTH)
    (set! (-> *pc-settings* secrets music i flava-mask) -1)))

(defmethod add-to-music-log ((obj pc-settings-jak1) (music symbol) (flava int))
  "add music and flava information to the music log.
   if music already exists, adds flava. if flava already exists, nothing happens."
  ;; go through our music log
  (dotimes (i PC_MUSIC_LOG_LENGTH)
    (cond
      ;; an empty log entry! place the currently playing music there, and fill flava.
      ((or (not (-> obj secrets music i name)) (zero? (not (-> obj secrets music i name))))
       (set! (-> obj secrets music i name) music)
       (set! (-> obj secrets music i flava-mask) (ash 1 flava))
       (return 0))
      ;; an existing log entry for the current music. fill flava.
      ((= music (-> obj secrets music i name)) (logior! (-> obj secrets music i flava-mask) (ash 1 flava)) (return 0))
      ;; something else. maybe the wrong entry, in which case nothing to do.
      ))
  0)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;; file I/O
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defmethod handle-input-settings ((obj pc-settings-jak1) (file file-stream))
  "handle the text parsing input for the 'settings' group"
  ((method-of-type pc-settings handle-input-settings) obj file)
  (case-str *pc-temp-string*
    (("money-starburst?") (set! (-> obj money-starburst?) (file-stream-read-symbol file)))
    (("extra-hud?") (set! (-> obj extra-hud?) (file-stream-read-symbol file)))
    (("skip-movies?") (set! (-> obj skip-movies?) (file-stream-read-symbol file)))
    (("subtitles?") (set! (-> obj subtitles?) (file-stream-read-symbol file)))
    (("subtitle-language") (set! (-> obj subtitle-language) (the-as pc-language (file-stream-read-int file))))
    (("text-language") (set! (-> obj text-language) (the-as pc-language (file-stream-read-int file))))
    (("scenes-seen") (dotimes (i PC_SPOOL_LOG_LENGTH) (set! (-> obj scenes-seen i) (file-stream-read-int file))))
    (("memcard-play-hints?") (set! (-> obj memcard-play-hints?) (file-stream-read-symbol file)))
    (("secrets")
     (dosettings (file)
                 (case-str *pc-temp-string*
                   (("hard-rats?") (set! (-> obj secrets hard-rats?) (file-stream-read-symbol file)))
                   (("hero-mode?") (set! (-> obj secrets hero-mode?) (file-stream-read-symbol file)))
                   (("hud-map?") (set! (-> obj secrets hud-map?) (file-stream-read-symbol file)))
                   (("hud-counters?") (set! (-> obj secrets hud-counters?) (file-stream-read-symbol file)))
                   (("hud-watch?") (set! (-> obj secrets hud-watch?) (file-stream-read-symbol file)))
                   (("watch-12hr?") (set! (-> obj secrets watch-12hr?) (file-stream-read-symbol file)))
                   (("art") (set! (-> obj secrets art) (the-as pc-jak1-concept-art (file-stream-read-int file))))
                   (("hard-fish-hiscore") (set! (-> obj secrets hard-fish-hiscore) (file-stream-read-int file)))
                   (("hard-rats-hiscore") (set! (-> obj secrets hard-rats-hiscore) (file-stream-read-int file)))
                   (("hard-rats-hiwave") (set! (-> obj secrets hard-rats-hiwave) (file-stream-read-int file)))
                   (("cheats")
                    (set! (-> obj cheats-known) (the pc-cheats (file-stream-read-int file)))
                    (set! (-> obj cheats) (logand (-> obj cheats-known) (file-stream-read-int file))))
                   (("music")
                    (dotimes (i PC_MUSIC_LOG_LENGTH)
                      (when (!= #x29 (file-stream-get-next-char-ret file))
                        (with-settings-scope (file)
                                             (set! (-> obj secrets music i name) (file-stream-read-symbol file))
                                             (set! (-> obj secrets music i flava-mask) (file-stream-read-int file))))))))))
  0)

(defmethod handle-output-settings ((obj pc-settings-jak1) (file file-stream))
  "handle the text writing output for the 'settings' group"
  ((method-of-type pc-settings handle-output-settings) obj file)
  (format file "  (money-starburst? ~A)~%" (-> obj money-starburst?))
  (format file "  (extra-hud? ~A)~%" (-> obj extra-hud?))
  (format file "  (skip-movies? ~A)~%" (-> obj skip-movies?))
  (format file "  (subtitles? ~A)~%" (-> obj subtitles?))
  (format file "  (subtitle-language ~D)~%" (-> obj subtitle-language))
  (format file "  (text-language ~D)~%" (-> obj text-language))
  (format file "  (memcard-play-hints? ~A)~%" (-> obj memcard-play-hints?))
  #|
  (format file "  (scenes-seen")
  (dotimes (i PC_SPOOL_LOG_LENGTH)
    (if (zero? (mod i 16))
      (format file "~%   ")
      )
    (format file " ~D" (-> obj scenes-seen i))
    )
  (format file "~%    )~%")
  |#
  (format file "  (secrets~%")
  #|
  (format file "    (art #x~X)~%" (-> obj secrets art))
  (format file "    (hard-rats? ~A)~%" (-> obj secrets hard-rats?))
  (format file "    (hero-mode? ~A)~%" (-> obj secrets hero-mode?))
  (format file "    (hud-map? ~A)~%" (-> obj secrets hud-map?))
  (format file "    (hud-counters? ~A)~%" (-> obj secrets hud-counters?))
  (format file "    (hard-fish-hiscore ~D)~%" (-> obj secrets hard-fish-hiscore))
  (format file "    (hard-rats-hiscore ~D)~%" (-> obj secrets hard-rats-hiscore))
  (format file "    (hard-rats-hiwave ~D)~%" (-> obj secrets hard-rats-hiwave))
  |#
  (format file "    (cheats #x~x #x~x)~%" (-> obj cheats-known) (-> obj cheats))
  (format file "    (music~%")
  (dotimes (i PC_MUSIC_LOG_LENGTH)
    (format file "      (~A #x~X)~%" (-> obj secrets music i name) (-> obj secrets music i flava-mask)))
  (format file "      )~%")
  (format file "    )~%")
  0)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;; Sandover settings apply
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; defined in drawable.gc, which loads after this file
(define-extern pc-set-shadows (function int float none))
;; defined in sparticle-launcher.gc, which loads after this file
(define-extern pc-set-hide-shafts (function int none))
(define-extern *sp-hide-light-shafts?* symbol)

;; What the engine was last told, as effective values. Starts at the engine's boot state (every
;; feature off), so only differences are pushed: an all-off sandover.gc pushes nothing.
(define *sandover-applied* (new 'static 'sandover-settings))

;; the HDR calibration pattern the engine was last told to draw (pc-set-hdr-output 8)
(define *sandover-calibration-pattern* 0)

;; set by progress-pc.gc: the pattern for the focused calibration row, 0 when the page is not up
(define *sandover-calibration-pattern-func* (the-as (function int) #f))

(defun sandover-boot-state! ((obj sandover-settings))
  "The engine's boot state as effective values: upstream's path, every Sandover feature off."
  (dotimes (i (-> *sandover-fields* length))
    (if (!= (-> *sandover-fields* i boot) SANDOVER_NO_BOOT)
      (sandover-field-set! obj (-> *sandover-fields* i) (-> *sandover-fields* i boot))))
  obj)

;; the render path last sent with pc-set-sandover-path (-1: not yet)
(define *sandover-path-sent* -1)


;; the mounted flag last sent (pc-set-motion-blur 11)
(define *sandover-vehicle* 0)

;; the audio output and device last sent (pc-set-audio-output); -1: not yet
(define *sandover-audio-sent* -1)
;; gk --audio-spatial as an output (0-4): runs instead of the Output row until that row is
;; confirmed, and is never saved. -2: not read yet, -1: none or dropped
(define *sandover-audio-cli* -2)
(define *sandover-audio-device-sent* (new 'global 'string 128 (the-as string #f)))

(defun sandover-audio-held? ()
  "gk --audio-spatial objects runs: Windows Spatial Sound is set up once per process, so the
   Audio rows hold."
  (= (pc-get-audio-state 4) 5))

(defun sandover-audio-cli-output ()
  "The command line's output for this session (gk --audio-spatial), or -1."
  (when (= *sandover-audio-cli* -2)
    (let ((cli (pc-get-audio-state 4)))
      (set! *sandover-audio-cli* (if (and (>= cli 0) (< cli 5)) cli -1))
      (if (>= *sandover-audio-cli* 0)
        (format 0 "[PC] Sandover audio output ~D from the command line (not saved)~%" cli))))
  *sandover-audio-cli*)

(defun sandover-audio-update ()
  "Push the Audio page's output and device when they change. Sound is not rendering: vanilla
   rendering leaves it alone, and REPL forms (pc-set-audio-spatial) stay until the menu changes.
   The command line's output overrides the saved row in the engine only."
  (when (not (sandover-audio-held?))
    (let* ((s (-> *pc-settings* sandover))
           (cli (sandover-audio-cli-output))
           (out (if (>= cli 0) cli (-> s audio-output))))
      (string<-charp *sandover-audio-device-str* (-> s audio-device))
      (when (or (!= out *sandover-audio-sent*)
                (not (string= *sandover-audio-device-str* *sandover-audio-device-sent*)))
        (set! *sandover-audio-sent* out)
        (copy-string<-string *sandover-audio-device-sent* *sandover-audio-device-str*)
        (pc-set-audio-output out *sandover-audio-device-str*))))
  (none))

(defun sandover-riding-vehicle? ()
  "The player rides the zoomer or the flut flut: the game's own mounted test, collide-action racer
   or flut on the target's root prim (set by target-racing-start and target-flut-start)."
  (and *target* (logtest? (-> *target* control root-prim prim-core action) (collide-action racer flut))))

(defun sandover-settings-reapply ()
  "Forget what was pushed: the next frame pushes every Sandover setting that differs from the boot state."
  (sandover-boot-state! *sandover-applied*)
  ;; the engine's AA mode and render scale may not be at boot: unknown, so the next push sends both
  (set! (-> *sandover-applied* upscaler) -2)
  (set! (-> *sandover-applied* render-scale) -1)
  ;; the render path too, so a REPL or rig override does not outlive the reapply
  (set! *sandover-path-sent* -1)
  (set! *sandover-calibration-pattern* 0)
  (set! (-> *sandover-applied* contact-shadows?) #f)
  (pc-set-shadow-option 41 0)
  (set! (-> *sandover-applied* motion-blur) 0)
  ;; motion blur shutter, radius cap and debug view (pc-set-motion-blur 2-6) back to the defaults
  (pc-set-motion-blur 7 1)
  ;; camera motion blur mode and the mounted flag back to the engine's boot state
  (pc-set-motion-blur 10 0)
  (set! *sandover-vehicle* 0)
  (pc-set-motion-blur 11 0)
  ;; the audio output is pushed again on the next frame (the engine skips an unchanged one)
  (set! *sandover-audio-sent* -1)
  ;; shafts drawn again (boot state); the flag, not pc-set-hide-shafts, which is unbound at load
  (set! *sp-hide-light-shafts?* #f)
  ;; shadow map size and taps (shadow option 40) back to the engine default, high
  (pc-set-shadow-option 40 2000000)
  ;; effect parameters that are not settings fields: back to the engine defaults (lava rules,
  ;; including its debug view and clock pin), so a rig shot cannot leak them into the next
  (pc-set-lava 15 1)
  ;; glow prop ranking (pc-set-emissive-lights 35-36) and eco shot lights (27-28) back to the
  ;; engine defaults
  (pc-set-emissive-lights 37 1)
  ;; FSR 3 debug view, sharpness and jitter, DLSS and FSR 4 jitter signs (pc-set-aa 2-4, 6, 7) back
  ;; to the defaults
  (pc-set-aa 5 1)
  ;; terrain sun cover strength (shadow option 20) back to the engine default, 1
  (pc-set-shadow-option 20 1000000)
  ;; water sun glint strength, roughness and peak (pc-set-water 95-97) back to the engine defaults
  (pc-set-water 98 1)
  ;; world sun map options (shadow options 32-38: receivers, map size, cascades, penumbra, range)
  ;; back to the engine defaults
  (pc-set-shadow-option 39 1)
  ;; sun disc size, glare, brightness, fade and HDR mode (pc-set-sun-option 11-18) back to the
  ;; engine defaults
  (pc-set-sun-option 19 1)
  ;; sky bodies style, starburst, wash, glow, moon, stars (pc-set-sun-option 20-28) back to the
  ;; engine defaults
  (pc-set-sun-option 29 1)
  (none))

(sandover-settings-reapply)

(defun sandover-vanilla? ((s sandover-settings))
  "Upstream's render path runs: the switch is on, or the engine cannot run temporal AA (below
   GL 4.3, or the FSR 3.1 programs did not build)."
  (or (-> s vanilla?) (zero? (pc-temporal-aa-state))))

(defun sandover-temporal-aa? ((s sandover-settings))
  "Temporal AA runs: not vanilla rendering (in stereo and XR one context per eye). Settings that
   accumulate over frames key off this."
  (and (not (-> s vanilla?)) (nonzero? (pc-temporal-aa-state))))

(defun sandover-stereo-engine? ()
  "The engine draws stereo or XR (pc-temporal-aa-state 2): contact shadows do not run there."
  (= (pc-temporal-aa-state) 2))

(defun sandover-xr-session? ()
  "An OpenXR session runs: the VR profile is active and the render scale sizes the eye frame."
  (nonzero? (pc-get-xr-state 0)))

;; REPL: 'flat or 'vr holds that profile whatever the XR state; #f follows the XR session
(define *sandover-profile-force* #f)

;; set by progress-pc.gc: #t while a menu row is being edited (its backup belongs to this profile)
(define *sandover-menu-editing-func* (the-as (function symbol) #f))

(defun sandover-profile-wanted ()
  "The profile the settings should run: the VR one while an OpenXR session runs."
  (cond
    (*sandover-profile-force* *sandover-profile-force*)
    ((sandover-xr-session?) 'vr)
    (else 'flat)))

(defun sandover-effective! ((dst sandover-settings) (src sandover-settings))
  "What the engine should run: vanilla rendering is the boot state; a list whose parent switch is
   off falls back to its boot state."
  (cond
    ((sandover-vanilla? src) (sandover-boot-state! dst))
    (else
     (mem-copy! (the-as pointer dst) (the-as pointer src) (size-of sandover-settings))
     (if (not (-> src pbr?)) (set! (-> dst pbr-look) -1))
     (if (not (-> src ssao?)) (set! (-> dst ssao-quality) 1))
     (if (not (-> src shadows?)) (set! (-> dst shadow-quality) 2))
     ;; no temporal AA: MSAA at the msaa setting; the render scale still sizes an XR eye frame
     (when (not (sandover-temporal-aa? src))
       (set! (-> dst upscaler) -1)
       (if (not (sandover-xr-session?)) (set! (-> dst render-scale) 0))
       (set! (-> dst contact-shadows?) #f))
     (if (sandover-stereo-engine?) (set! (-> dst contact-shadows?) #f))
     (when (not (-> src hdr-target?))
       (set! (-> dst tonemap) 0)
       (set! (-> dst hdr-output) 2))
     (when (= (-> dst hdr-output) 2)
       (set! (-> dst paper-white) 200.0)
       (set! (-> dst hdr-peak) -1.0)
       (set! (-> dst hdr-black) -1.0))
     dst)))

(defun sandover-vista-apply ((on? symbol))
  "Neighbour levels with unified fog and haze (the forms of `sandover-preset apply vista haze`)."
  (cond
    (on?
     (pc-set-vista-fog "unified" 150 150 800)
     (pc-set-vista-neighbour-fog "clear" -1 -1 -1)
     (pc-set-vista-haze 850 200 #x8d8f80 700)
     (pc-set-vista-neighbour-fog "misty" 16000 #x7a7771 -1)
     (pc-set-vista-neighbour-haze "misty" 0)
     (pc-set-vista-neighbour-fog "rolling" 10000 #x6a6978 -1)
     (pc-set-vista-neighbour-fog "village2" 16000 #x656581 -1)
     (pc-set-vista-neighbour-fog "training" 7000 #x767371 -1)
     (pc-set-vista-neighbour-haze "training" 0)
     (pc-set-vista-option 5 (the int (&-> *time-of-day-context* time)))
     (pc-set-vista-option 12 1)
     (pc-set-vista "neighbours"))
    (else
     (pc-set-vista "none")
     (pc-set-vista-option 12 0)
     (pc-set-vista-haze 0 -1 -1 -1)
     (pc-set-vista-fog "vanilla" -1 -1 -1)))
  (none))

(defmacro sandover-changed? (field)
  `(!= (-> want ,field) (-> old ,field)))

(defun sandover-settings-update ()
  "Push the Sandover settings that changed since the last push, once per frame (main.gc).
   Nothing is sent while they match what the engine was last told, so REPL and rig forms stay."
  ;; the profile follows the XR session; not while a row is being edited
  (let ((profile (sandover-profile-wanted)))
    (if (and (!= profile *sandover-profile*)
             (not (and *sandover-menu-editing-func* (*sandover-menu-editing-func*))))
      (sandover-profile-switch! profile)))
  (let ((path (if (sandover-vanilla? (-> *pc-settings* sandover)) 0 1)))
    (when (!= path *sandover-path-sent*)
      (set! *sandover-path-sent* path)
      (pc-set-sandover-path path)))
  (let ((want (sandover-effective! (new 'stack-no-clear 'sandover-settings) (-> *pc-settings* sandover)))
        (old *sandover-applied*))
    (when (or (sandover-changed? ssao?) (sandover-changed? ssao-quality))
      (cond
        ((-> want ssao?) (pc-set-ssao-preset (-> want ssao-quality)) (pc-set-ssao-param 15 1000000))
        (else (pc-set-ssao-preset -1))))
    (if (sandover-changed? tile-lights?) (pc-set-emissive-lights 0 (if (-> want tile-lights?) 1000000 0)))
    (when (sandover-changed? bloom?)
      (cond
        ((-> want bloom?) (pc-set-bloom 0 1000000) (pc-set-bloom 4 1000000))
        (else (pc-set-bloom 0 0))))
    (when (sandover-changed? shadows?)
      (cond
        ((-> want shadows?) (pc-set-shadows 1 1.0) (pc-set-shadow-option 5 300000) (pc-set-shadow-option 30 1000000))
        (else (pc-set-shadows 0 1.0))))
    (if (sandover-changed? shadow-quality) (pc-set-shadow-option 40 (* 1000000 (-> want shadow-quality))))
    (if (and (sandover-changed? pbr-look) (>= (-> want pbr-look) 0))
      (pc-set-pbr-param 11 (* 1000000 (+ 1 (-> want pbr-look)))))
    (when (sandover-changed? pbr?)
      (pc-set-pbr-param 0 (if (-> want pbr?) 1 0))
      ;; the remaster look drops the fake sun-ray particles (beach grotto, jungle)
      (pc-set-hide-shafts (if (-> want pbr?) 1 0)))
    (if (sandover-changed? fur?) (pc-set-fur 0 (if (-> want fur?) 1000000 0)))
    (if (sandover-changed? water?) (pc-set-water 0 (if (-> want water?) 1000000 0)))
    (if (sandover-changed? glint?) (pc-set-water 94 (if (-> want glint?) 1000000 0)))
    ;; on = the strong level
    (if (sandover-changed? contact-shadows?) (pc-set-shadow-option 41 (if (-> want contact-shadows?) 2000000 0)))
    (if (sandover-changed? motion-blur) (pc-set-motion-blur 0 (* 1000000 (-> want motion-blur))))
    (if (sandover-changed? camera-blur) (pc-set-motion-blur 10 (* 1000000 (-> want camera-blur))))
    (if (sandover-changed? vista?) (sandover-vista-apply (-> want vista?)))
    (when (sandover-changed? sun?)
      ;; the disc follows the hour through the clock address the vista switch otherwise sends
      (if (and (-> want sun?) (not (-> want vista?)))
        (pc-set-vista-option 5 (the int (&-> *time-of-day-context* time))))
      (pc-set-sun-option 10 (if (-> want sun?) 1000000 0)))
    (if (sandover-changed? hdr-target?) (pc-set-hdr-target (-> want hdr-target?)))
    (if (sandover-changed? tonemap) (pc-set-tonemap 0 (* 1000000 (-> want tonemap))))
    (if (sandover-changed? paper-white) (pc-set-hdr-output 2 (the int (* 1000000.0 (-> want paper-white)))))
    ;; GOAL int math is 32-bit: a peak in millionths overflows above 2147 nits, so send thousandths
    (if (sandover-changed? hdr-peak) (pc-set-hdr-output 9 (the int (* 1000.0 (-> want hdr-peak)))))
    (if (sandover-changed? hdr-black) (pc-set-hdr-output 4 (the int (* 1000000.0 (-> want hdr-black)))))
    (when (sandover-changed? hdr-output)
      (cond
        ((= (-> want hdr-output) 2) (pc-set-hdr-output 0 0))
        (else (pc-set-hdr-output 1 (* 1000000 (-> want hdr-output))) (pc-set-hdr-output 0 1000000))))
    ;; engine mode: 0 MSAA (applied upscaler -1), 1 FSR 3.1, 2 DLSS, 3 FSR 4 (FSR 3.1 where
    ;; unavailable)
    (if (sandover-changed? upscaler) (pc-set-aa 0 (* 1000000 (+ 1 (-> want upscaler)))))
    (if (sandover-changed? render-scale) (pc-set-aa 1 (sandover-render-scale-millionths (-> want render-scale))))
    (mem-copy! (the-as pointer old) (the-as pointer want) (size-of sandover-settings)))
  (sandover-audio-update)
  ;; the mounted flag, on change (camera motion blur, Vehicles)
  (let ((riding (if (sandover-riding-vehicle?) 1 0)))
    (when (!= riding *sandover-vehicle*)
      (set! *sandover-vehicle* riding)
      (pc-set-motion-blur 11 riding)))
  (let ((pattern (if *sandover-calibration-pattern-func* (*sandover-calibration-pattern-func*) 0)))
    (when (!= pattern *sandover-calibration-pattern*)
      (set! *sandover-calibration-pattern* pattern)
      (pc-set-hdr-output 8 (* 1000000 pattern))))
  (none))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;; PC settings
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define-once *pc-settings* (new 'global 'pc-settings-jak1))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;; other
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun draw-build-revision ()
  (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id debug-no-zbuf))
    (draw-string-xy *pc-settings-built-sha*
                    buf
                    0
                    (* 10 (-> (get-video-params) relative-y-scale))
                    (font-color flat-yellow)
                    (font-flags shadow kerning))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;; process pools
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; the actor pool for PC processes! it has space for 4 processes, with 16K of space.
(define *pc-dead-pool* (new 'global 'dead-pool 4 (* 16 1024) '*pc-dead-pool*))
