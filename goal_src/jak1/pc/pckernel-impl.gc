;;-*-Lisp-*-
(in-package goal)
(require "pc/pckernel-h.gc")

#| This file has the game-specific implementation of the pckernel (see pckernel-h.gc and pckernel.gc). |#

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;; constants
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; version: 1.10.4.0
(defconstant PC_KERNEL_VERSION (static-pckernel-version 1 10 4 0))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;; types and enums
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; pc enum for languages. this is the game's languages + custom ones.
(defenum pc-language
  :type uint16
  (english 0)
  (french 1)
  (german 2)
  (spanish 3)
  (italian 4)
  (japanese 5)
  (uk-english 6)
  ;; custom
  (portuguese 7)
  (finnish 8)
  (swedish 9)
  (danish 10)
  (norwegian 11)
  (dutch 12)
  (br-portuguese 13)
  (hungarian 14)
  (catalan 15)
  (icelandic 16)
  (korean 17)
  (russian 18)
  (polish 19)
  (lithuanian 20)
  (czech 21)
  (croatian 22)
  (galician 23)
  (bosnian 24)
  (custom 999) ;; temp
  )

;; concept arts
(defenum pc-jak1-concept-art
  :bitfield #t
  :type uint64
  (test))

;; secrets and goodies
(deftype pc-game-secrets (structure)
  ((art               pc-jak1-concept-art) ;; concept art unlocked
   (music             pc-music-log-entry PC_MUSIC_LOG_LENGTH :inline)
   (hard-fish-hiscore int32)
   (hard-rats?        symbol) ;; enable this crap
   (hard-rats-hiscore int32)
   (hard-rats-hiwave  int32)
   (hero-mode?        symbol) ;; unsure how this should work
   (hud-map?          symbol) ;; enable map in HUD/progress?
   (hud-counters?     symbol) ;; enable level orb counter/global buzzer counter?
   (hud-watch?        symbol) ;; a watch that tells the time of day!
   (watch-12hr?       symbol) ;; 12-hour clock toggle
   )
  :pack-me)

;; Sandover enhancement settings, saved to sandover.gc next to pc-settings.gc (never into it:
;; an unmodified OpenGOAL resets every setting on an unknown key). See sandover/kb/howto/settings.md.
(defconstant SANDOVER_SETTINGS_VERSION 4)

(deftype sandover-settings (structure)
  ((vanilla?     symbol) ;; upstream's render path: MSAA at the msaa setting, no Sandover effects
   (ssao?        symbol)
   (tile-lights? symbol)
   (bloom?       symbol)
   (shadows?     symbol)
   (pbr?         symbol)
   (pbr-look     int32) ;; 0 faithful, 1 bold, 2 cinematic (-1 in the applied copy: untouched)
   (fur?         symbol)
   (water?       symbol)
   (vista?       symbol)
   (hdr-target?  symbol)
   (tonemap      int32) ;; 0 clamp, 1 filmic, 2 toon
   (hdr-output   int32) ;; 0 scrgb, 1 pq, 2 off
   (paper-white  float) ;; nits, 80..400
   (hdr-peak     float) ;; nits, 400..10000; negative = what the display reports
   (hdr-black    float) ;; nits, 0..1; negative = what the display reports
   (render-scale int32) ;; 0..5 = 100, 77, 67, 59, 50, 33 percent of the display size
   (upscaler     int32) ;; temporal AA: 0 fsr3 (FSR 3.1), 1 dlss (DLSS), 2 fsr4 (FSR 4); applied copy: -1 MSAA, -2 unknown
   (ssao-quality int32) ;; 0 low, 1 medium, 2 high, 3 ultra (ssao preset of the same index)
   (shadow-quality int32) ;; 0 low, 1 medium, 2 high (shadow option 40)
   (sun?         symbol) ;; the sun disc in the sky
   (glint?       symbol) ;; the sun glint on the ocean and inland water
   (contact-shadows? symbol) ;; screen-space contact shadows (shadow option 41)
   (motion-blur  int32) ;; 0 off, 1 weak, 2 medium, 3 strong (pc-set-motion-blur 0)
   (camera-blur  int32) ;; camera motion blur: 0 off, 1 vehicles, 2 always (pc-set-motion-blur 10)
   (audio-output int32) ;; 0 auto, 1 stereo, 2 5.1, 3 7.1, 4 headphones, 5 spatial (next start)
   (audio-device uint8 128) ;; OpenAL Soft device name, NUL-terminated; empty: the Windows default
   (msaa         int32)) ;; the stock MSAA row's value while this profile is not active (gfx-msaa is the active one's)
  :pack-me)

(defmacro sandover-render-scale-millionths (idx)
  "100%, 1/1.3, 1/1.5, 1/1.7, 1/2 and 1/3 of the display size: native, ultra quality, then the FSR 3.1
   quality, balanced, performance and ultra performance ratios"
  `(case ,idx ((1) 769231) ((2) 666667) ((3) 588235) ((4) 500000) ((5) 333333) (else 1000000)))

(defmacro sandover-temporal-upscaler? (&rest ignored)
  "Temporal AA runs for the current settings (sandover-temporal-aa?): rows that need it key off this."
  `(sandover-temporal-aa? (-> *pc-settings* sandover)))

;; One row per sandover-settings field, in file order: the key, how the value is read, written and reset,
;; and the engine's boot state. The reset, boot-state, read and write loops run over it.
(defconstant SANDOVER_FIELD_BOOL 0) ;; a symbol, #t or #f
(defconstant SANDOVER_FIELD_ENUM 1) ;; an int32 index into names, a symbol in the file
(defconstant SANDOVER_FIELD_INTMAP 2) ;; an int32 index into ints, the int in the file
(defconstant SANDOVER_FIELD_FLOAT 3) ;; a float, clamped to lo..hi when read
(defconstant SANDOVER_FIELD_WORD 4) ;; an int32 index into words, a bare word in the file
(defconstant SANDOVER_FIELD_BYTES 5) ;; a NUL-terminated byte array of size, a quoted string in the file
(defconstant SANDOVER_FIELD_INT 6) ;; an int32 the writer takes as an argument, only when it is not negative
(defconstant SANDOVER_FLAG_NEGATIVE 1) ;; below zero follows the display: -1.0 in memory, -1 in the file
(defconstant SANDOVER_FLAG_DECIMALS 2) ;; written with three decimals
(defconstant SANDOVER_NO_BOOT #x7fffffff) ;; boot: the boot state leaves the field alone

(deftype sandover-field (structure)
  ((key      string)
   (kind     int32)
   (offset   int32) ;; bytes from the start of sandover-settings (checked against the type by test_settings_forms.py)
   (names    (array symbol)) ;; enum values in index order
   (words    (array string)) ;; word values in index order
   (ints     (array int32)) ;; int-map file values in index order
   (fallback int32) ;; the index written for a value outside the list
   (lo       float)
   (hi       float)
   (flags    int32)
   (size     int32)
   (default  int32) ;; floats too: converted when set
   (boot     int32)))

(defmacro sandover-field-addr (obj f)
  `(+ (the-as int ,obj) (-> ,f offset)))

(define *sandover-fields*
  (new 'static 'boxed-array :type sandover-field
    (new 'static 'sandover-field :key "vanilla-rendering?" :offset 0 :default 0 :boot 1)
    (new 'static 'sandover-field :key "ssao?" :offset 4 :default 1 :boot 0)
    (new 'static 'sandover-field :key "tile-lights?" :offset 8 :default 1 :boot 0)
    (new 'static 'sandover-field :key "bloom?" :offset 12 :default 1 :boot 0)
    (new 'static 'sandover-field :key "shadows?" :offset 16 :default 1 :boot 0)
    (new 'static 'sandover-field :key "materials?" :offset 20 :default 1 :boot 0)
    (new 'static 'sandover-field :key "material-look" :kind SANDOVER_FIELD_ENUM :offset 24
      :names (new 'static 'boxed-array :type symbol 'faithful 'bold 'cinematic) :fallback 1 :default 1 :boot -1)
    (new 'static 'sandover-field :key "fur?" :offset 28 :default 1 :boot 0)
    (new 'static 'sandover-field :key "water?" :offset 32 :default 1 :boot 0)
    (new 'static 'sandover-field :key "neighbours?" :offset 36 :default 1 :boot 0)
    (new 'static 'sandover-field :key "fp16-target?" :offset 40 :default 1 :boot 0)
    (new 'static 'sandover-field :key "tonemap" :kind SANDOVER_FIELD_ENUM :offset 44
      :names (new 'static 'boxed-array :type symbol 'clamp 'filmic 'toon) :fallback 2 :default 2 :boot 0)
    (new 'static 'sandover-field :key "hdr-output" :kind SANDOVER_FIELD_ENUM :offset 48
      :names (new 'static 'boxed-array :type symbol 'scrgb 'pq 'off) :fallback 0 :default 1 :boot 2)
    (new 'static 'sandover-field :key "paper-white-nits" :kind SANDOVER_FIELD_FLOAT :offset 52
      :lo 80.0 :hi 400.0 :default 200 :boot 200)
    (new 'static 'sandover-field :key "hdr-peak-nits" :kind SANDOVER_FIELD_FLOAT :offset 56
      :lo 400.0 :hi 10000.0 :flags SANDOVER_FLAG_NEGATIVE :default -1 :boot -1)
    ;; lo is below any value that reaches the clamp: only hi applies
    (new 'static 'sandover-field :key "hdr-black-nits" :kind SANDOVER_FIELD_FLOAT :offset 60
      :lo -1.0 :hi 1.0 :flags 3 :default -1 :boot -1)
    (new 'static 'sandover-field :key "render-scale" :kind SANDOVER_FIELD_INTMAP :offset 64
      :ints (new 'static 'boxed-array :type int32 100 77 67 59 50 33) :fallback 0 :default 0 :boot 0)
    ;; the spatial upscalers of older files (bilinear, fsr) keep the default
    (new 'static 'sandover-field :key "upscaler" :kind SANDOVER_FIELD_ENUM :offset 68
      :names (new 'static 'boxed-array :type symbol 'fsr3 'dlss 'fsr4) :fallback 0 :default 0 :boot -1)
    (new 'static 'sandover-field :key "ssao-quality" :kind SANDOVER_FIELD_ENUM :offset 72
      :names (new 'static 'boxed-array :type symbol 'low 'medium 'high 'ultra) :fallback 1 :default 1 :boot 1)
    (new 'static 'sandover-field :key "shadow-quality" :kind SANDOVER_FIELD_ENUM :offset 76
      :names (new 'static 'boxed-array :type symbol 'low 'medium 'high) :fallback 2 :default 2 :boot 2)
    (new 'static 'sandover-field :key "sun?" :offset 80 :default 1 :boot 0)
    (new 'static 'sandover-field :key "glint?" :offset 84 :default 1 :boot 0)
    (new 'static 'sandover-field :key "contact-shadows?" :offset 88 :default 0 :boot 0)
    (new 'static 'sandover-field :key "motion-blur" :kind SANDOVER_FIELD_ENUM :offset 92
      :names (new 'static 'boxed-array :type symbol 'off 'weak 'medium 'strong) :fallback 2 :default 2 :boot 0)
    (new 'static 'sandover-field :key "camera-blur" :kind SANDOVER_FIELD_ENUM :offset 96
      :names (new 'static 'boxed-array :type symbol 'off 'vehicles 'always) :fallback 1 :default 1 :boot 0)
    ;; words: 5.1 would read as a number
    (new 'static 'sandover-field :key "audio-output" :kind SANDOVER_FIELD_WORD :offset 100
      :words (new 'static 'boxed-array :type string "auto" "stereo" "5.1" "7.1" "headphones" "spatial") :fallback 0 :default 0
      :boot SANDOVER_NO_BOOT)
    (new 'static 'sandover-field :key "audio-device" :kind SANDOVER_FIELD_BYTES :offset 104
      :size 128 :boot SANDOVER_NO_BOOT)
    ;; VR profile only: the flat profile's MSAA is the stock row in pc-settings.gc
    (new 'static 'sandover-field :key "msaa" :kind SANDOVER_FIELD_INT :offset 232
      :default PC_DEFAULT_MSAA :boot SANDOVER_NO_BOOT)))

(defun sandover-field-find ((key string))
  "The index of the row for a file key, or -1."
  (let ((found -1))
    (dotimes (i (-> *sandover-fields* length))
      (if (and (< found 0) (string= key (-> *sandover-fields* i key)))
        (set! found i)))
    found))

(defun sandover-field-off? ((obj sandover-settings) (f sandover-field))
  "A switch is off at #f, a list or number at zero."
  (if (= (-> f kind) SANDOVER_FIELD_BOOL)
    (not (-> (the-as (pointer symbol) (sandover-field-addr obj f))))
    (zero? (-> (the-as (pointer int32) (sandover-field-addr obj f))))))

(defun sandover-field-set! ((obj sandover-settings) (f sandover-field) (v int))
  "Set a field from a table value (the default or boot column)."
  (case (-> f kind)
    ((SANDOVER_FIELD_BOOL) (set! (-> (the-as (pointer symbol) (sandover-field-addr obj f))) (nonzero? v)))
    ((SANDOVER_FIELD_FLOAT) (set! (-> (the-as (pointer float) (sandover-field-addr obj f))) (the float v)))
    ((SANDOVER_FIELD_BYTES) (set! (-> (the-as (pointer uint8) (sandover-field-addr obj f)) 0) 0))
    (else (set! (-> (the-as (pointer int32) (sandover-field-addr obj f))) v)))
  0)

(defun sandover-settings-reset! ((obj sandover-settings))
  "Defaults: the play build's look, everything on."
  (dotimes (i (-> *sandover-fields* length))
    (sandover-field-set! obj (-> *sandover-fields* i) (-> *sandover-fields* i default)))
  obj)

(defconstant SANDOVER_VR_RENDER_SCALE 2) ;; 67%: under 4K-class pixels per eye on a PSVR2

(defun sandover-settings-reset-vr! ((obj sandover-settings))
  "VR profile defaults: the flat defaults, with the eye frame drawn at 67% of its size."
  (sandover-settings-reset! obj)
  (set! (-> obj render-scale) SANDOVER_VR_RENDER_SCALE)
  obj)

;; The Jak 1 version of the pc-settings object.
(deftype pc-settings-jak1 (pc-settings)
  ((cheats              pc-cheats)
   (cheats-known        pc-cheats)
   (skip-movies?        symbol) ;; if on, enable cutscene skipping
   (subtitles?          symbol) ;; if on, cutscene subtitles will show up
   (text-language       pc-language) ;; language for game text
   (subtitle-language   pc-language) ;; language for subtitles
   (money-starburst?    symbol) ;; add a starburst to the money
   (extra-hud?          symbol) ;; extra hud elements.
   (secrets             pc-game-secrets :inline) ;; hidden goodies and additional secrets!
   (scenes-seen         uint8 PC_SPOOL_LOG_LENGTH) ;; cutscenes that have been seen, by spool-anim (maybe use 8-char name or bits instead?)
   (memcard-play-hints? symbol)
   (sandover            sandover-settings :inline) ;; the active profile: what the menu edits and the engine runs
   (sandover-other      sandover-settings :inline))) ;; the inactive profile (flat screen or VR)

(define *pc-settings* (the pc-settings-jak1 #f))

;; the profile *pc-settings* sandover holds: 'flat or 'vr (the VR one while an OpenXR session runs)
(define *sandover-profile* 'flat)

;; jak 1 discord rpc structure
(deftype discord-info (structure)
  ((fuel         (pointer float))
   (money-total  (pointer float))
   (buzzer-total (pointer float))
   (deaths       (pointer int32))
   (status       string)
   (level        string)
   (cutscene?    symbol)
   (ogreboss?    symbol)
   (plant-boss?  symbol)
   (racer?       symbol)
   (flutflut?    symbol)
   (time-of-day  (pointer float))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;; debug settings
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define *fallback-text-lookup?* #t)

(define *display-bug-report* #f)

(define *mood-override-debug* #f)

(define *mood-override-table* (new 'global 'inline-array 'float 8))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;; resets
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defmethod reset-misc ((obj pc-settings-jak1) (call-handlers symbol))
  "Set the default misc settings"
  ((method-of-type pc-settings reset-misc) obj call-handlers)
  (set! (-> obj text-language) (the pc-language (scf-get-language)))
  (set! (-> obj subtitle-language) (the pc-language (scf-get-language)))
  (set! (-> obj skip-movies?) #t)
  (set! (-> obj subtitles?) *debug-segment*)
  (cond
    ((and (= *default-territory* GAME_TERRITORY_SCEE) (= (-> obj text-language) (pc-language english)))
     (set! (-> obj text-language) (pc-language uk-english))
     ;(set! (-> obj subtitle-language) (pc-language uk-english))
     )
    ((= *default-territory* GAME_TERRITORY_SCEI)
     (set! (-> obj text-language) (pc-language japanese))
     ;(set! (-> obj subtitle-language) (pc-language japanese))
     )
    (else))
  (set! (-> obj money-starburst?) #f)
  (set! (-> obj extra-hud?) #f)
  ;; original settings, minus 25 to be a bit more conservative
  (set! (-> obj memcard-volume-sfx) 50.0)
  (set! (-> obj memcard-volume-music) 40.0)
  (set! (-> obj memcard-volume-dialog) 75.0)
  (set! (-> obj memcard-vibration?) #t)
  (set! (-> obj memcard-play-hints?) #t)
  0)

(defmethod reset-extra ((obj pc-settings-jak1) (call-handlers symbol))
  "Set the default goodies settings"
  ((method-of-type pc-settings reset-extra) obj call-handlers)
  (set! (-> obj cheats) (pc-cheats))
  (set! (-> obj cheats-known) (pc-cheats))
  (dotimes (i PC_SPOOL_LOG_LENGTH)
    (set! (-> obj scenes-seen i) 0))
  (dotimes (i PC_MUSIC_LOG_LENGTH)
    (set! (-> obj secrets music i name) #f)
    (set! (-> obj secrets music i flava-mask) 0))
  (set! (-> obj secrets art) (pc-jak1-concept-art))
  (set! (-> obj secrets hard-fish-hiscore) 0)
  (set! (-> obj secrets hard-rats-hiscore) 0)
  (set! (-> obj secrets hard-rats-hiwave) 0)
  (set! (-> obj secrets hard-rats?) #f)
  (set! (-> obj secrets hero-mode?) #f)
  (set! (-> obj secrets hud-map?) #t)
  (set! (-> obj secrets hud-counters?) #t)
  (set! (-> obj secrets hud-watch?) #f)
  (set! (-> obj secrets watch-12hr?) #f)
  (cond
    ((= *sandover-profile* 'vr)
     (sandover-settings-reset-vr! (-> obj sandover))
     (sandover-settings-reset! (-> obj sandover-other)))
    (else
     (sandover-settings-reset! (-> obj sandover))
     (sandover-settings-reset-vr! (-> obj sandover-other))))
  0)

